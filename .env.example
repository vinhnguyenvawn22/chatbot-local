# Sao chép file này thành .env nếu muốn thay đổi cấu hình mặc định.
DOCUMENT_DIR=../document
CHROMA_DIR=./storage/chroma
COLLECTION_NAME=school_documents

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
# 0: giải phóng Qwen khỏi RAM/VRAM sau mỗi câu trả lời.
OLLAMA_KEEP_ALIVE=0

EMBEDDING_MODEL=BAAI/bge-m3
# auto: ưu tiên NVIDIA GPU nếu PyTorch CUDA sẵn sàng, nếu không dùng CPU.
EMBEDDING_DEVICE=auto
# RTX 3050 Laptop có 4 GB VRAM nên để batch nhỏ để tránh thiếu bộ nhớ.
EMBEDDING_BATCH_SIZE=2

CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=5
MAX_SUBQUESTIONS=4
TOP_K_PER_SUBQUESTION=2
MAX_TOTAL_DOCUMENTS=6

# LangSmith là tùy chọn. Khi bật, dữ liệu trace được gửi lên LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=school-chatbot-local
